{
    "redirects": [
        {
            "source": "/:path*",
            "has": [{ "type": "host", "value": "binpaste.xyz" }],
            "destination": "https://www.binpaste.xyz/:path*",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/((?!api/|find$|public$|guides$|pastebin-alternative$|terms$)[^/.]+)",
            "destination": "/api/paste-meta?slug=$1"
        },
        {
            "source": "/(.*)",
            "destination": "/"
        }
    ]
}
