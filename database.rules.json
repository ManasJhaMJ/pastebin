{
  /* Realtime Database security rules for BinPaste.

     Deliberately wide open for now - anyone can read or write anything. That
     includes reading private pastes and overwriting or deleting existing ones.
     Revisit when it matters; see git history for a locked-down version that
     allows create-only writes, expiry-gated reads and increment-only counters.

     ".indexOn" below is NOT a permission. It grants and denies nothing, so it
     cannot break any feature. It only tells Firebase to index pastes by
     createdAt, which is what keeps the paginated /public query from
     downloading the whole node and sorting it in the browser. */
  "rules": {
    ".read": true,
    ".write": true,

    "pastes": {
      ".indexOn": "createdAt"
    }
  }
}
